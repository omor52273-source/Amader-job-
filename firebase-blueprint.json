{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with balances, role, and KYC status",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string", "enum": ["worker", "employer", "admin"] },
        "avatar": { "type": "string" },
        "earningBalanceUSD": { "type": "number" },
        "earningBalanceBDT": { "type": "number" },
        "depositBalanceUSD": { "type": "number" },
        "depositBalanceBDT": { "type": "number" },
        "isVerified": { "type": "boolean" },
        "kycStatus": { "type": "string", "enum": ["none", "pending", "verified", "rejected"] }
      },
      "required": ["id", "name", "email", "role"]
    },
    "Job": {
      "title": "Job",
      "description": "Micro-task job available in marketplace",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "titleBn": { "type": "string" },
        "description": { "type": "string" },
        "descriptionBn": { "type": "string" },
        "category": { "type": "string" },
        "platform": { "type": "string" },
        "payPerTaskUSD": { "type": "number" },
        "payPerTaskBDT": { "type": "number" },
        "totalSlots": { "type": "number" },
        "completedSlots": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "paused", "completed"] },
        "employerId": { "type": "string" },
        "employerName": { "type": "string" }
      },
      "required": ["id", "title", "payPerTaskUSD", "totalSlots", "status", "employerId"]
    },
    "TaskSubmission": {
      "title": "TaskSubmission",
      "description": "Proof submitted by worker for a job",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "jobId": { "type": "string" },
        "workerId": { "type": "string" },
        "workerName": { "type": "string" },
        "proofText": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "earnedUSD": { "type": "number" },
        "earnedBDT": { "type": "number" },
        "submittedAt": { "type": "string" }
      },
      "required": ["id", "jobId", "workerId", "proofText", "status"]
    },
    "WalletTransaction": {
      "title": "WalletTransaction",
      "description": "Financial deposit, withdrawal, or job post transaction",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["deposit", "withdrawal", "job_post", "earning", "transfer", "daily_streak"] },
        "amountUSD": { "type": "number" },
        "amountBDT": { "type": "number" },
        "status": { "type": "string", "enum": ["completed", "pending", "failed"] },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "type", "amountUSD", "amountBDT", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile documents"
    },
    "/jobs/{jobId}": {
      "schema": "Job",
      "description": "Public jobs in the microtask marketplace"
    },
    "/submissions/{submissionId}": {
      "schema": "TaskSubmission",
      "description": "Worker submissions for verification"
    },
    "/transactions/{transactionId}": {
      "schema": "WalletTransaction",
      "description": "User deposit and withdrawal transaction ledger"
    }
  }
}
