# ========================================================
# Amader Job Online - Apache Configuration for cPanel
# Production Ready: HTTPS, Canonical SEO, Caching, Security
# ========================================================

Options -Indexes
Options +FollowSymLinks

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTPS for SEO & Security in Production
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP_HOST} ^microjob\.bahubal\.com$ [NC]
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # 2. Block access to sensitive configuration, database and environment files
  RewriteRule ^\.env.*$ - [F,L]
  RewriteRule ^database\.sql$ - [F,L]
  RewriteRule ^.*\.log$ - [F,L]
  RewriteRule ^composer\.(json|lock)$ - [F,L]
  RewriteRule ^package(-lock)?\.json$ - [F,L]
  RewriteRule ^README\.md$ - [F,L]
  RewriteRule ^includes/ - [F,L]
  RewriteRule ^config/ - [F,L]

  # 3. Prevent script execution in uploads directory
  RewriteRule ^uploads/.*\.php$ - [F,L]

  # 4. Route API endpoints to api/index.php
  RewriteRule ^api/(.*)$ api/index.php [QSA,L]
  RewriteRule ^api$ api/index.php [QSA,L]

  # 5. Allow direct access to admin panel
  RewriteRule ^admin/?$ admin/index.php [QSA,L]

  # 6. Direct sitemap & robots access
  RewriteRule ^sitemap\.xml$ sitemap.xml [L]
  RewriteRule ^robots\.txt$ robots.txt [L]

  # 7. Serve existing static files and directories directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 8. Route all frontend SPA routes to index.php
  RewriteRule ^ index.php [QSA,L]
</IfModule>

# Custom Error Page for SEO
ErrorDocument 404 /index.php

# Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Gzip / Deflate Compression for Performance & Core Web Vitals
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml image/svg+xml
</IfModule>

# Browser Caching Headers
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType application/x-javascript "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresDefault "access plus 2 days"
</IfModule>

# MIME Types for ES modules and modern assets
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType application/xml .xml
</IfModule>
