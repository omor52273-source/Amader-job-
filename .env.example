# ==========================================
# Amader Job Online - Environment Configuration
# ==========================================

# Application URL (Single source of truth for domain, redirects, referral links, and password resets)
APP_URL=https://example.com

# Database Connection (cPanel MySQL / MariaDB)
DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password

# Environment Mode
APP_ENV=production
APP_DEBUG=false

# SMTP Mail Server Configuration
# Note: You can also configure and test SMTP directly from the Admin Panel (/admin/)
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USERNAME=info@example.com
SMTP_PASSWORD=your_email_password
SMTP_ENCRYPTION=tls
SMTP_FROM_EMAIL=info@example.com
SMTP_FROM_NAME="Amader Job"

# Legacy / Alternative aliases
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=true
SMTP_FROM=

# Optional Gemini API Key (if AI features are used)
GEMINI_API_KEY=
